# Copy thành .env: `cp .env.example .env`
# Giá trị mặc định dưới đây chạy được ngay với `docker compose up -d` (Mongo rs0 + Redis local).

# ==========================================
# SERVER
# ==========================================
APP_HOST=localhost
APP_PORT=3000
# dev: trả stack trace + log cache chi tiết. Production BẮT BUỘC đặt "production".
BUILD_MODE=dev
# URL frontend. Dùng cho CORS (Express + Socket.IO), link trong email, returnUrl của PayOS.
CLIENT_URL=http://localhost:5173

# ==========================================
# DATABASE
# ==========================================
# Tên database lấy từ PATH của URI (/fitlink_db). Thiếu path → Mongoose âm thầm dùng database "test".
# Phải là replica set (rs0): luồng thanh toán dùng transaction.
MONGODB_URI=mongodb://127.0.0.1:27017/fitlink_db?replicaSet=rs0&directConnection=true
# Không được đọc khi kết nối (xem config/database.js) — giữ cho khớp URI.
DATABASE_NAME=fitlink_db

# ==========================================
# AUTH / JWT
# ==========================================
# Chuỗi ngẫu nhiên dài. Có ký tự "$" thì bọc trong nháy đơn '...' (docker compose nội suy "$").
ACCESS_TOKEN_SECRET=change-me-local-access-secret
REFRESH_TOKEN_SECRET=change-me-local-refresh-secret
# Tên biến viết sai chính tả nhưng PHẢI giữ nguyên. true khi chạy HTTPS.
IS_SERCURE_COOKIE=false
COOKIE_SAMESITE=lax

# ==========================================
# CACHE (Redis)
# ==========================================
# local = Redis trong docker compose · cloud = REDIS_CLOUD_URI · memory = không dùng Redis
# Redis không kết nối được thì tự rơi về in-memory, API vẫn chạy.
REDIS_MODE=local
REDIS_LOCAL_URI=redis://127.0.0.1:6379
REDIS_CLOUD_URI=
CACHE_DEFAULT_TTL=300

# ==========================================
# NGHIỆP VỤ
# ==========================================
# Phần trăm phí nền tảng trừ vào tiền PT nhận.
PLATFORM_FEE_PERCENT=20

# ==========================================
# DỊCH VỤ BÊN THỨ BA — để trống vẫn khởi động được, chỉ tính năng tương ứng hỏng
# ==========================================
# Google login. Phải trùng VITE_GG_CLIENT_ID của fitlink-portal (Client ID là public).
GG_CLIENT_ID=686626573895-23r6hpi2kk7elc411k0vggur97kd2ien.apps.googleusercontent.com

# Gmail SMTP (App Password). Trống → ĐĂNG KÝ tài khoản mới và quên mật khẩu trả lỗi 500.
# Dùng tài khoản seed (`npm run seed`) để đăng nhập khi chưa có.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Cloudinary. Trống → upload ảnh (avatar user, ảnh hồ sơ PT) lỗi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayOS (dùng key sandbox). Trống → bước "Thanh toán" không tạo được link QR.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Webhook n8n cho trang AI chat. Trống → AI chat không trả lời.
CHATBOT_GPT_N8N_API=
